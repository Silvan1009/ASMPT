@inherits LayoutComponentBase
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" BackdropClick="false" MaxWidth="MaxWidth.Small" FullWidth="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None" Typo="Typo.h6" Class="mr-6">ASMPT</MudLink>
        <MudButton Href="/" Color="Color.Inherit">Home</MudButton>
        <MudButton Href="/production" Color="Color.Inherit">Production</MudButton>
        <MudButton Href="/echo" Color="Color.Inherit">Echo</MudButton>
        <AuthorizeView Roles="@FirebaseRoles.Admin">
            <MudButton Href="/users" Color="Color.Inherit">Users</MudButton>
        </AuthorizeView>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-4">@(context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? context.User.Identity?.Name)</MudText>
                @* Plain (non-enhanced) form POST: only a full request can clear the cookie. The antiforgery
                   token reaches the interactive circuit through persisted component state. *@
                <form method="post" action="/logout">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@CurrentPath" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small">Log out</MudButton>
                </form>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Color="Color.Inherit">Log in</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent>
                    <MudAlert Severity="Severity.Error" Class="mb-3">
                        Something went wrong. Try again; if it keeps happening, quote this error reference:
                        <code>@(System.Diagnostics.Activity.Current?.TraceId.ToHexString() ?? "unavailable")</code>
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="ml-2" OnClick="@(() => _errorBoundary?.Recover())">Try again</MudButton>
                    </MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    private string CurrentPath => "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

    // A navigation replaces Body with a new page; leave the previous page's error state behind.
    protected override void OnParametersSet() => _errorBoundary?.Recover();
}
