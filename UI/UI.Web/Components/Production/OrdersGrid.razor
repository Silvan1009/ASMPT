@inherits ProductionGridBase<OrderDto>
@inject IJSRuntime JS

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudTextField @bind-Value="Search" @bind-Value:after="LoadAsync" Immediate="true" DebounceInterval="300"
                  Placeholder="Search name or description" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mud-width-full" />
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => OpenDialogAsync(null))">Add order</MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.Delete" Variant="Variant.Outlined" Color="Color.Error"
               Disabled="@(Selected.Count == 0)" OnClick="DeleteSelectedAsync">Delete selected (@Selected.Count)</MudButton>
</MudStack>

<ApiStatusAlert SessionExpired="SessionExpired" Error="@Error" Reference="@ErrorReference" ReloadHref="/production" />

<MudDataGrid T="OrderDto" Items="Items" Loading="Loading" MultiSelection="true" SelectOnRowClick="false"
             @bind-SelectedItems="Selected" SortMode="SortMode.Single" Dense="true" Hover="true" Elevation="0">
    <Columns>
        <SelectColumn T="OrderDto" />
        <PropertyColumn Property="x => x.Name" Title="Name" />
        <PropertyColumn Property="x => x.Description" Title="Description" />
        <PropertyColumn Property="x => x.OrderDate" Title="Order date" Format="yyyy-MM-dd" />
        <TemplateColumn Title="Boards" Sortable="false">
            <CellTemplate>@string.Join(", ", context.Item.Boards.Select(b => b.Name))</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false" CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" title="Download" OnClick="@(() => DownloadAsync(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="Edit" OnClick="@(() => OpenDialogAsync(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" title="Delete" OnClick="@(() => DeleteAsync(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>No orders found.</NoRecordsContent>
</MudDataGrid>

@code {
    private IJSObjectReference? _downloadModule;

    protected override string EntityName => "order";

    protected override string EntityNamePlural => "orders";

    protected override async Task<ICollection<OrderDto>> FetchAsync(string? search, CancellationToken cancellationToken)
        => await Api.GetOrdersAsync(search, cancellationToken);

    protected override Task DeleteOneAsync(Guid id) => Api.DeleteOrderAsync(id);

    protected override Task DeleteManyAsync(BatchDeleteRequest request) => Api.DeleteOrdersAsync(request);

    protected override Task<IDialogReference> ShowDialogAsync(OrderDto? order)
        => DialogService.ShowAsync<OrderDialog>(
            order is null ? "New order" : "Edit order",
            new DialogParameters<OrderDialog> { { x => x.Order, order } });

    private async Task DownloadAsync(OrderDto order)
    {
        try
        {
            using var file = await Api.DownloadOrderAsync(order.Id);
            _downloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/download.js");
            using var streamRef = new DotNetStreamReference(file.Stream);
            await _downloadModule.InvokeVoidAsync("downloadFileFromStream", FileNameFrom(file) ?? $"order-{order.Id}.json", streamRef);
        }
        catch (Exception ex) when (ApiErrors.IsApiFailure(ex) || ex is JSException)
        {
            ShowError(ex, "Downloading the order failed.");
        }
    }

    private static string? FileNameFrom(FileResponse file)
    {
        if (!file.Headers.TryGetValue("Content-Disposition", out var values))
        {
            return null;
        }

        return System.Net.Http.Headers.ContentDispositionHeaderValue.TryParse(values.FirstOrDefault(), out var disposition)
            ? disposition.FileNameStar ?? disposition.FileName?.Trim('"')
            : null;
    }

    public override async ValueTask DisposeAsync()
    {
        await base.DisposeAsync();
        try
        {
            if (_downloadModule is not null)
            {
                await _downloadModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone (e.g. the tab was closed); nothing to clean up on the client.
        }
    }
}
