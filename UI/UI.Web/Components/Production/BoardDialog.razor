@inherits EntityDialogBase

<MudDialog>
    <DialogContent>
        @if (Error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@Error</MudAlert>
        }
        <MudForm @ref="Form">
            <MudTextField @bind-Value="Name" Label="Name" Required="true" RequiredError="Name is required" MaxLength="200" Immediate="true"
                          Error="@HasError(nameof(BoardRequest.Name))" ErrorText="@ErrorText(nameof(BoardRequest.Name))" />
            <MudTextField @bind-Value="Description" Label="Description" Lines="3" MaxLength="2000" Class="mt-3"
                          Error="@HasError(nameof(BoardRequest.Description))" ErrorText="@ErrorText(nameof(BoardRequest.Description))" />
            <MudStack Row="true" Class="mt-3">
                <MudNumericField @bind-Value="_length" Label="Length (mm)" Min="0.01" Max="100000" Format="F2" Required="true"
                                  Error="@HasError(nameof(BoardRequest.Length))" ErrorText="@ErrorText(nameof(BoardRequest.Length))" />
                <MudNumericField @bind-Value="_width" Label="Width (mm)" Min="0.01" Max="100000" Format="F2" Required="true"
                                  Error="@HasError(nameof(BoardRequest.Width))" ErrorText="@ErrorText(nameof(BoardRequest.Width))" />
            </MudStack>
            <MudSelect T="Guid" @bind-SelectedValues="_componentIds" MultiSelection="true" SelectAll="true" SelectAllText="Select all"
                       Label="Components" Required="true" RequiredError="Select at least one component" Class="mt-3"
                       ToStringFunc="@(id => _componentNames.GetValueOrDefault(id, id.ToString()))"
                       Error="@HasError(nameof(BoardRequest.ComponentIds))" ErrorText="@ErrorText(nameof(BoardRequest.ComponentIds))">
                @foreach (var component in _components)
                {
                    <MudSelectItem T="Guid" Value="@component.Id">@component.Name</MudSelectItem>
                }
            </MudSelect>
            @if (_components.Count == 0 && Error is null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">No components yet: create components on the Components tab first.</MudText>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="Saving">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Existing board to edit; null creates a new one.</summary>
    [Parameter]
    public BoardDto? Board { get; set; }

    private double _length;
    private double _width;
    private IReadOnlyCollection<Guid>? _componentIds = [];
    private ICollection<ComponentDto> _components = [];
    private Dictionary<Guid, string> _componentNames = [];

    protected override string EntityName => "board";

    protected override IReadOnlyCollection<string> KnownFields { get; } =
        [nameof(BoardRequest.Name), nameof(BoardRequest.Description), nameof(BoardRequest.Length), nameof(BoardRequest.Width), nameof(BoardRequest.ComponentIds)];

    protected override async Task OnInitializedAsync()
    {
        if (Board is not null)
        {
            Name = Board.Name;
            Description = Board.Description;
            _length = (double)Board.Length;
            _width = (double)Board.Width;
        }

        // Load the component names before setting the pre-selected ids below: OnInitializedAsync's first
        // (pre-await) render already shows MudSelect's SelectedValues, and MudSelect only resolves each
        // selected value's display text once, at that point. Setting _componentIds before _componentNames
        // is ready would freeze the summary text on the raw ids.
        try
        {
            _components = await Api.GetComponentsAsync();
            _componentNames = _components.ToDictionary(c => c.Id, c => c.Name);
        }
        catch (Exception ex) when (ApiErrors.IsApiFailure(ex))
        {
            Logger.LogError(ex, "Loading components for the board dialog failed");
            Error = "Components could not be loaded. Close the dialog and try again.";
            return;
        }

        if (Board is not null)
        {
            _componentIds = Board.Components.Select(c => c.Id).ToList();
        }
    }

    protected override async Task<object> SaveCoreAsync()
    {
        var request = new BoardRequest
        {
            Name = TrimmedName,
            Description = TrimmedDescription,
            Length = _length,
            Width = _width,
            ComponentIds = (_componentIds ?? []).ToList(),
        };

        return Board is null
            ? await Api.CreateBoardAsync(request)
            : await Api.UpdateBoardAsync(Board.Id, request);
    }
}
