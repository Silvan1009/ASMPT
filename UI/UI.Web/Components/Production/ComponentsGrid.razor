@inject IServiceApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<ComponentsGrid> Logger

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudTextField @bind-Value="_search" @bind-Value:after="LoadAsync" Immediate="true" DebounceInterval="300"
                  Placeholder="Search name or description" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mud-width-full" />
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => OpenDialogAsync(null))">Add component</MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.Delete" Variant="Variant.Outlined" Color="Color.Error"
               Disabled="@(_selected.Count == 0)" OnClick="DeleteSelectedAsync">Delete selected (@_selected.Count)</MudButton>
</MudStack>

@if (_sessionExpired)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">Your session has expired. <MudLink Href="/production">Reload the page</MudLink> to sign in again.</MudAlert>
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
}

<MudDataGrid T="ComponentDto" Items="_components" Loading="_loading" MultiSelection="true" SelectOnRowClick="false"
             @bind-SelectedItems="_selected" SortMode="SortMode.Single" Dense="true" Hover="true" Elevation="0">
    <Columns>
        <SelectColumn T="ComponentDto" />
        <PropertyColumn Property="x => x.Name" Title="Name" />
        <PropertyColumn Property="x => x.Description" Title="Description" />
        <PropertyColumn Property="x => x.Quantity" Title="Quantity" />
        <TemplateColumn Title="Boards" Sortable="false">
            <CellTemplate>@string.Join(", ", context.Item.Boards.Select(b => b.Name))</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false" CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="Edit" OnClick="@(() => OpenDialogAsync(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" title="Delete" OnClick="@(() => DeleteAsync(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>No components found.</NoRecordsContent>
</MudDataGrid>

@code {
    private List<ComponentDto> _components = [];
    private HashSet<ComponentDto> _selected = [];
    private string _search = "";
    private bool _loading = true;
    private bool _sessionExpired;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _components = [.. await Api.GetComponentsAsync(string.IsNullOrWhiteSpace(_search) ? null : _search)];
            _selected = [];
        }
        catch (Exception ex) when (ApiErrors.IsApiFailure(ex))
        {
            ShowError(ex, "Loading components failed.");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenDialogAsync(ComponentDto? component)
    {
        var parameters = new DialogParameters<ComponentDialog> { { x => x.Component, component } };
        var dialog = await DialogService.ShowAsync<ComponentDialog>(component is null ? "New component" : "Edit component", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add(component is null ? "Component created." : "Component saved.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(ComponentDto component)
    {
        if (await DialogService.ShowMessageBoxAsync("Delete component", $"Delete \"{component.Name}\"? It will be removed from any boards that use it.", yesText: "Delete", cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            await Api.DeleteComponentAsync(component.Id);
            Snackbar.Add("Component deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) when (ApiErrors.IsApiFailure(ex))
        {
            ShowError(ex, "Deleting the component failed.");
        }
    }

    private async Task DeleteSelectedAsync()
    {
        var ids = _selected.Select(c => c.Id).ToList();
        if (await DialogService.ShowMessageBoxAsync("Delete components", $"Delete {ids.Count} selected component(s)? They will be removed from any boards that use them.", yesText: "Delete", cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            await Api.DeleteComponentsAsync(new BatchDeleteRequest { Ids = ids });
            Snackbar.Add($"{ids.Count} component(s) deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) when (ApiErrors.IsApiFailure(ex))
        {
            ShowError(ex, "Deleting the components failed.");
        }
    }

    private void ShowError(Exception ex, string message)
    {
        if (ApiErrors.IsSessionExpired(ex))
        {
            _sessionExpired = true;
            return;
        }

        Logger.LogError(ex, "{Message}", message);
        _error = message;
    }
}
