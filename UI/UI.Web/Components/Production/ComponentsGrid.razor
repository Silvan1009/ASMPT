@inherits ProductionGridBase<ComponentDto>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudTextField @bind-Value="Search" @bind-Value:after="LoadAsync" Immediate="true" DebounceInterval="300"
                  Placeholder="Search name or description" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mud-width-full" />
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => OpenDialogAsync(null))">Add component</MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.Delete" Variant="Variant.Outlined" Color="Color.Error"
               Disabled="@(Selected.Count == 0)" OnClick="DeleteSelectedAsync">Delete selected (@Selected.Count)</MudButton>
</MudStack>

<ApiStatusAlert SessionExpired="SessionExpired" Error="@Error" Reference="@ErrorReference" ReloadHref="/production" />

<MudDataGrid T="ComponentDto" Items="Items" Loading="Loading" MultiSelection="true" SelectOnRowClick="false"
             @bind-SelectedItems="Selected" SortMode="SortMode.Single" Dense="true" Hover="true" Elevation="0">
    <Columns>
        <SelectColumn T="ComponentDto" />
        <PropertyColumn Property="x => x.Name" Title="Name" />
        <PropertyColumn Property="x => x.Description" Title="Description" />
        <PropertyColumn Property="x => x.Quantity" Title="Quantity" />
        <TemplateColumn Title="Boards" Sortable="false">
            <CellTemplate>@string.Join(", ", context.Item.Boards.Select(b => b.Name))</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false" CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="Edit" OnClick="@(() => OpenDialogAsync(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" title="Delete" OnClick="@(() => DeleteAsync(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>No components found.</NoRecordsContent>
</MudDataGrid>

@code {
    protected override string EntityName => "component";

    protected override string EntityNamePlural => "components";

    protected override string DeleteWarning => " Deleted components are removed from any boards that use them.";

    protected override async Task<ICollection<ComponentDto>> FetchAsync(string? search, CancellationToken cancellationToken)
        => await Api.GetComponentsAsync(search, cancellationToken);

    protected override Task DeleteOneAsync(Guid id) => Api.DeleteComponentAsync(id);

    protected override Task DeleteManyAsync(BatchDeleteRequest request) => Api.DeleteComponentsAsync(request);

    protected override Task<IDialogReference> ShowDialogAsync(ComponentDto? component)
        => DialogService.ShowAsync<ComponentDialog>(
            component is null ? "New component" : "Edit component",
            new DialogParameters<ComponentDialog> { { x => x.Component, component } });
}
