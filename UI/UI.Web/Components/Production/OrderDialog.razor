@inherits EntityDialogBase

<MudDialog>
    <DialogContent>
        @if (Error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@Error</MudAlert>
        }
        <MudForm @ref="Form">
            <MudTextField @bind-Value="Name" Label="Name" Required="true" RequiredError="Name is required" MaxLength="200" Immediate="true"
                          Error="@HasError(nameof(OrderRequest.Name))" ErrorText="@ErrorText(nameof(OrderRequest.Name))" />
            <MudTextField @bind-Value="Description" Label="Description" Lines="3" MaxLength="2000" Class="mt-3"
                          Error="@HasError(nameof(OrderRequest.Description))" ErrorText="@ErrorText(nameof(OrderRequest.Description))" />
            <MudDatePicker @bind-Date="_orderDate" Label="Order date" Required="true" Editable="true" DateFormat="yyyy-MM-dd" Class="mt-3"
                           Error="@HasError(nameof(OrderRequest.OrderDate))" ErrorText="@ErrorText(nameof(OrderRequest.OrderDate))" />
            <MudSelect T="Guid" @bind-SelectedValues="_boardIds" MultiSelection="true" SelectAll="true" SelectAllText="Select all"
                       Label="Boards" Required="true" RequiredError="Select at least one board" Class="mt-3"
                       ToStringFunc="@(id => _boardNames.GetValueOrDefault(id, id.ToString()))"
                       Error="@HasError(nameof(OrderRequest.BoardIds))" ErrorText="@ErrorText(nameof(OrderRequest.BoardIds))">
                @foreach (var board in _boards)
                {
                    <MudSelectItem T="Guid" Value="@board.Id">@board.Name</MudSelectItem>
                }
            </MudSelect>
            @if (_boards.Count == 0 && Error is null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">No boards yet: create boards on the Boards tab first.</MudText>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="Saving">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Existing order to edit; null creates a new one.</summary>
    [Parameter]
    public OrderDto? Order { get; set; }

    private DateTime? _orderDate = DateTime.Today;
    private IReadOnlyCollection<Guid>? _boardIds = [];
    private ICollection<BoardDto> _boards = [];
    private Dictionary<Guid, string> _boardNames = [];

    protected override string EntityName => "order";

    protected override IReadOnlyCollection<string> KnownFields { get; } =
        [nameof(OrderRequest.Name), nameof(OrderRequest.Description), nameof(OrderRequest.OrderDate), nameof(OrderRequest.BoardIds)];

    protected override async Task OnInitializedAsync()
    {
        if (Order is not null)
        {
            Name = Order.Name;
            Description = Order.Description;
            _orderDate = Order.OrderDate.ToDateTime(TimeOnly.MinValue);
        }

        // Load the board names before setting the pre-selected ids below: OnInitializedAsync's first
        // (pre-await) render already shows MudSelect's SelectedValues, and MudSelect only resolves each
        // selected value's display text once, at that point. Setting _boardIds before _boardNames is ready
        // would freeze the summary text on the raw ids.
        try
        {
            _boards = await Api.GetBoardsAsync();
            _boardNames = _boards.ToDictionary(b => b.Id, b => b.Name);
        }
        catch (Exception ex) when (ApiErrors.IsApiFailure(ex))
        {
            Logger.LogError(ex, "Loading boards for the order dialog failed");
            Error = "Boards could not be loaded. Close the dialog and try again.";
            return;
        }

        if (Order is not null)
        {
            _boardIds = Order.Boards.Select(b => b.Id).ToList();
        }
    }

    protected override async Task<object> SaveCoreAsync()
    {
        var request = new OrderRequest
        {
            Name = TrimmedName,
            Description = TrimmedDescription,
            // The picker is Required, so a valid form always carries a date; the server rejects null anyway.
            OrderDate = _orderDate is { } date ? DateOnly.FromDateTime(date) : null,
            BoardIds = (_boardIds ?? []).ToList(),
        };

        return Order is null
            ? await Api.CreateOrderAsync(request)
            : await Api.UpdateOrderAsync(Order.Id, request);
    }
}
