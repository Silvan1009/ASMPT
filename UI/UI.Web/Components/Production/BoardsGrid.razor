@inherits ProductionGridBase<BoardDto>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudTextField @bind-Value="Search" @bind-Value:after="LoadAsync" Immediate="true" DebounceInterval="300"
                  Placeholder="Search name or description" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mud-width-full" />
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => OpenDialogAsync(null))">Add board</MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.Delete" Variant="Variant.Outlined" Color="Color.Error"
               Disabled="@(Selected.Count == 0)" OnClick="DeleteSelectedAsync">Delete selected (@Selected.Count)</MudButton>
</MudStack>

<ApiStatusAlert SessionExpired="SessionExpired" Error="@Error" Reference="@ErrorReference" ReloadHref="/production" />

<MudDataGrid T="BoardDto" Items="Items" Loading="Loading" MultiSelection="true" SelectOnRowClick="false"
             @bind-SelectedItems="Selected" SortMode="SortMode.Single" Dense="true" Hover="true" Elevation="0">
    <Columns>
        <SelectColumn T="BoardDto" />
        <PropertyColumn Property="x => x.Name" Title="Name" />
        <PropertyColumn Property="x => x.Description" Title="Description" />
        <PropertyColumn Property="x => x.Length" Title="Length (mm)" Format="F2" />
        <PropertyColumn Property="x => x.Width" Title="Width (mm)" Format="F2" />
        <TemplateColumn Title="Components" Sortable="false">
            <CellTemplate>@string.Join(", ", context.Item.Components.Select(c => c.Name))</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Orders" Sortable="false">
            <CellTemplate>@string.Join(", ", context.Item.Orders.Select(o => o.Name))</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false" CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="Edit" OnClick="@(() => OpenDialogAsync(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" title="Delete" OnClick="@(() => DeleteAsync(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>No boards found.</NoRecordsContent>
</MudDataGrid>

@code {
    protected override string EntityName => "board";

    protected override string EntityNamePlural => "boards";

    protected override string DeleteWarning => " Deleted boards are removed from any orders that use them.";

    protected override async Task<ICollection<BoardDto>> FetchAsync(string? search, CancellationToken cancellationToken)
        => await Api.GetBoardsAsync(search, cancellationToken);

    protected override Task DeleteOneAsync(Guid id) => Api.DeleteBoardAsync(id);

    protected override Task DeleteManyAsync(BatchDeleteRequest request) => Api.DeleteBoardsAsync(request);

    protected override Task<IDialogReference> ShowDialogAsync(BoardDto? board)
        => DialogService.ShowAsync<BoardDialog>(
            board is null ? "New board" : "Edit board",
            new DialogParameters<BoardDialog> { { x => x.Board, board } });
}
