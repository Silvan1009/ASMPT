@inherits EntityDialogBase

<MudDialog>
    <DialogContent>
        @if (Error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@Error</MudAlert>
        }
        <MudForm @ref="Form">
            <MudTextField @bind-Value="Name" Label="Name" Required="true" RequiredError="Name is required" MaxLength="200" Immediate="true"
                          Error="@HasError(nameof(ComponentRequest.Name))" ErrorText="@ErrorText(nameof(ComponentRequest.Name))" />
            <MudTextField @bind-Value="Description" Label="Description" Lines="3" MaxLength="2000" Class="mt-3"
                          Error="@HasError(nameof(ComponentRequest.Description))" ErrorText="@ErrorText(nameof(ComponentRequest.Description))" />
            <MudNumericField @bind-Value="_quantity" Label="Quantity" Min="0" Max="1000000" Required="true" Class="mt-3"
                              Error="@HasError(nameof(ComponentRequest.Quantity))" ErrorText="@ErrorText(nameof(ComponentRequest.Quantity))" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="Saving">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Existing component to edit; null creates a new one.</summary>
    [Parameter]
    public ComponentDto? Component { get; set; }

    private int _quantity;

    protected override string EntityName => "component";

    protected override IReadOnlyCollection<string> KnownFields { get; } =
        [nameof(ComponentRequest.Name), nameof(ComponentRequest.Description), nameof(ComponentRequest.Quantity)];

    protected override void OnInitialized()
    {
        if (Component is not null)
        {
            Name = Component.Name;
            Description = Component.Description;
            _quantity = Component.Quantity;
        }
    }

    protected override async Task<object> SaveCoreAsync()
    {
        var request = new ComponentRequest
        {
            Name = TrimmedName,
            Description = TrimmedDescription,
            Quantity = _quantity,
        };

        return Component is null
            ? await Api.CreateComponentAsync(request)
            : await Api.UpdateComponentAsync(Component.Id, request);
    }
}
