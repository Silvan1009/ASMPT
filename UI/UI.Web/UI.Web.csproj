<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>asmpt-ui-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.9.0" />
    <PackageReference Include="NSwag.ApiDescription.Client" Version="14.7.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Generates a typed C# client from the Service's committed OpenAPI document on every
         build. Rebuild Service/Service.slnx first to refresh that document after an API change. -->
    <OpenApiReference Include="..\..\Service\Service.Api\OpenApi\Service.Api.json"
                      CodeGenerator="NSwagCSharp"
                      Namespace="UI.Web.ApiClient"
                      ClassName="ServiceApiClient"
                      OutputPath="ServiceApiClient.g.cs">
      <Options>/JsonLibrary:SystemTextJson /GenerateClientInterfaces:true /UseBaseUrl:false /OperationGenerationMode:SingleClientFromOperationId /GenerateOptionalParameters:true /GeneratePrepareRequestAndProcessResponseAsAsyncMethods:true /DateType:System.DateOnly</Options>
    </OpenApiReference>
  </ItemGroup>

</Project>
